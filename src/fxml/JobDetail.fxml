<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.JobDetailController">
    <!-- ????-->
    <VBox styleClass="navbar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 24; -fx-spacing: 16; -fx-alignment: center; -fx-fill-width: true;">
            <Label text="BUPT TA System" styleClass="navbar-title" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox style="-fx-spacing: 8; -fx-alignment: center;">
                <Button text="Home" styleClass="navbar-menu" onAction="#handleBack" />
                <Button text="Job Board" styleClass="navbar-menu" onAction="#handleBack" />
                <Button text="Job Detail" styleClass="navbar-menu active" onAction="#handleBack" />
                <Button text="Back to Dashboard" styleClass="navbar-menu" onAction="#handleBack" />
            </HBox>
        </HBox>
    </VBox>

    <!-- ???? -->
    <ScrollPane style="-fx-background-color: #f8f9fa;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="64.0">
        <StackPane style="-fx-background-color: #f8f9fa; -fx-padding: 32px;">
            <VBox style="-fx-spacing: 24px; -fx-background-color: #f8f9fa; -fx-pref-width: 900px; -fx-max-width: 900px;">

                <!-- ???? -->
                <HBox alignment="CENTER_LEFT" style="-fx-spacing: 16;">
                    <VBox style="-fx-spacing: 8;">
                        <Label text="Job Detail" styleClass="page-title" />
                        <Label text="View full job information" styleClass="page-subtitle" />
                    </VBox>
                </HBox>

                <!-- ?????? -->
                <VBox styleClass="card shadow-md" style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-padding: 24px;">
                    <Label fx:id="titleLabel" text="Job Title" style="-fx-font-size: 24px; -fx-font-weight: 700; -fx-text-fill: #2c3e50; -fx-padding: 0 0 16 0;" />

                    <GridPane vgap="12" hgap="30" style="-fx-fill-width: true;">
                        <columnConstraints>
                            <ColumnConstraints minWidth="100" prefWidth="120" />
                            <ColumnConstraints minWidth="200" prefWidth="250" />
                            <ColumnConstraints minWidth="100" prefWidth="120" />
                            <ColumnConstraints minWidth="200" prefWidth="250" />
                        </columnConstraints>

                        <!-- ????-->
                        <Label text="Department:" style="-fx-font-weight: bold; -fx-text-fill: #495057;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="departmentLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Job Type:" style="-fx-font-weight: bold; -fx-text-fill: #495057;" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <Label fx:id="typeLabel" text="-" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                        <!-- ????-->
                        <Label text="Work Time:" style="-fx-font-weight: bold; -fx-text-fill: #495057;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="workTimeLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Openings:" style="-fx-font-weight: bold; -fx-text-fill: #495057;" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <HBox style="-fx-spacing: 4;" GridPane.columnIndex="3" GridPane.rowIndex="1">
                            <Label fx:id="currentNumLabel" text="0" />
                            <Label text="/" />
                            <Label fx:id="recruitNumLabel" text="-" />
                        </HBox>

                        <!-- ????-->
                        <Label text="Deadline:" style="-fx-font-weight: bold; -fx-text-fill: #495057;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="deadlineLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Salary:" style="-fx-font-weight: bold; -fx-text-fill: #495057;" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        <Label fx:id="salaryLabel" text="-" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                        <!-- ????-->
                        <Label text="Location:" style="-fx-font-weight: bold; -fx-text-fill: #495057;" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <Label fx:id="locationLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Status:" style="-fx-font-weight: bold; -fx-text-fill: #495057;" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                        <Label fx:id="statusLabel" text="-" GridPane.columnIndex="3" GridPane.rowIndex="3" />

                        <!-- Progress -->
                        <Label text="Progress:" style="-fx-font-weight: bold; -fx-text-fill: #495057;" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <HBox style="-fx-spacing: 8; -fx-alignment: center;" GridPane.columnIndex="1" GridPane.rowIndex="4" GridPane.columnSpan="3">
                            <ProgressBar fx:id="progressBar" style="-fx-pref-width: 200px;" />
                            <Label fx:id="progressText" text="0/0 applicants" />
                        </HBox>

                        <!-- ????-->
                        <Label text="Publisher:" style="-fx-font-weight: bold; -fx-text-fill: #495057;" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                        <Label fx:id="publisherLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                        <Label text="Published On:" style="-fx-font-weight: bold; -fx-text-fill: #495057;" GridPane.columnIndex="2" GridPane.rowIndex="5" />
                        <Label fx:id="publishDateLabel" text="-" GridPane.columnIndex="3" GridPane.rowIndex="5" />
                    </GridPane>
                </VBox>

                <!-- ???? -->
                <VBox styleClass="card shadow-md" style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-padding: 24px;">
                    <Label text="Job Description" style="-fx-font-size: 18px; -fx-font-weight: 600; -fx-text-fill: #495057; -fx-padding: 0 0 12 0;" />
                    <TextArea fx:id="descriptionArea" editable="false" wrapText="true" style="-fx-pref-height: 150px; -fx-background-radius: 8px;" />
                </VBox>

                <!-- ?????-->
                <VBox styleClass="card shadow-md" style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-padding: 24px;">
                    <Label text="Skills" style="-fx-font-size: 18px; -fx-font-weight: 600; -fx-text-fill: #495057; -fx-padding: 0 0 12 0;" />
                    <FlowPane fx:id="skillsBox" style="-fx-hgap: 12; -fx-vgap: 10; -fx-pref-width: 100%; -fx-alignment: center;" />
                </VBox>

                <!-- ???? -->
                <VBox styleClass="card shadow-md" style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-padding: 24px;">
                    <Label text="Additional Requirements" style="-fx-font-size: 18px; -fx-font-weight: 600; -fx-text-fill: #495057; -fx-padding: 0 0 12 0;" />
                    <TextArea fx:id="extraRequirementsArea" editable="false" wrapText="true" style="-fx-pref-height: 100px; -fx-background-radius: 8px;" />
                </VBox>

                <!-- ???? -->
                <HBox style="-fx-spacing: 16; -fx-alignment: center;">
                    <Button fx:id="backButton" text="Back to Job List" styleClass="btn btn-secondary" onAction="#handleBack" />
                    <Button fx:id="applyButton" text="Apply" styleClass="btn btn-primary" onAction="#handleApply" />
                    <Label fx:id="appliedLabel" text="Already Applied" style="-fx-text-fill: #28a745; -fx-font-weight: bold;" visible="false" />
                </HBox>

            </VBox>
        </StackPane>
    </ScrollPane>
</AnchorPane>




