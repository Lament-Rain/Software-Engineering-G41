<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MOApplicationReviewController">
    <VBox styleClass="navbar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 24; -fx-spacing: 16; -fx-alignment: center; -fx-fill-width: true;">
            <Label text="BUPT TA System" styleClass="navbar-title" />
            <HBox style="-fx-spacing: 8; -fx-alignment: center; -fx-padding: 0 0 0 8;">
                <StackPane styleClass="user-avatar mo">
                    <Label text="MO" style="-fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 14px;" />
                </StackPane>
                <Label text="Welcome, Module Organizer" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox style="-fx-spacing: 8; -fx-alignment: center;">
                <Button text="Home" styleClass="navbar-menu" onAction="#handleBack" accessibleText="Go to home page" />
                <Button text="Job Board" styleClass="navbar-menu" onAction="#handleViewAllJobs" accessibleText="Browse jobs" />
                <Button text="My Jobs" styleClass="navbar-menu" onAction="#handleViewMyJobs" accessibleText="My jobs" />
                <Button text="Application Review" styleClass="navbar-menu active" onAction="#handleBack" accessibleText="Application review" />
                <Button text="Personal Center" styleClass="navbar-menu" onAction="#handlePersonalCenter" accessibleText="Go to personal center" />
                <Button text="Logout" styleClass="navbar-menu" style="-fx-pref-width: 150px;" onAction="#handleLogout" accessibleText="Log out" />
            </HBox>
        </HBox>
    </VBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: #f9fafb;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="72.0">
        <VBox style="-fx-padding: 48px; -fx-spacing: 32px; -fx-background-color: #f9fafb; -fx-pref-width: 1240px;">
            <VBox style="-fx-spacing: 8; -fx-fill-width: true;">
                <Label text="Application Review" styleClass="page-title" />
                <Label text="Choose one of your jobs to review applicants and mark them as screened, accepted, or rejected." styleClass="page-subtitle" />
            </VBox>

            <VBox styleClass="card" style="-fx-fill-width: true;">
                <VBox style="-fx-spacing: 4; -fx-padding: 0 0 12 0;">
                    <Label text="Select Job" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                </VBox>
                <ComboBox fx:id="jobSelector" promptText="Choose a job" styleClass="combo-box" style="-fx-pref-width: 420px;" accessibleText="Select a job to review applications" />
            </VBox>

            <HBox style="-fx-spacing: 24;" alignment="CENTER_LEFT">
                <VBox styleClass="stat-card">
                    <Label text="Applicants" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" />
                    <Label fx:id="applicantCountLabel" text="0" styleClass="stat-value" />
                </VBox>
                <VBox styleClass="stat-card">
                    <Label text="Accepted" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" />
                    <Label fx:id="acceptedCountLabel" text="0" styleClass="stat-value" style="-fx-text-fill: #10b981;" />
                </VBox>
                <VBox styleClass="stat-card">
                    <Label text="Pending / Screened" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" />
                    <Label fx:id="pendingCountLabel" text="0" styleClass="stat-value" style="-fx-text-fill: #f59e0b;" />
                </VBox>
                <StackPane style="-fx-pref-width: 60px; -fx-pref-height: 60px;">
                    <ProgressIndicator fx:id="loadingIndicator" visible="false" style="-fx-progress-color: #003366;" />
                </StackPane>
            </HBox>

            <HBox spacing="24" alignment="TOP_LEFT">
                <VBox styleClass="card" style="-fx-pref-width: 770px;">
                    <HBox style="-fx-spacing: 12; -fx-alignment: center-left; -fx-fill-width: true; -fx-padding: 0 0 16 0;">
                        <Label text="Applicant List" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                        <Label text="Sort by" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
                        <ComboBox fx:id="sortModeSelector" styleClass="combo-box" style="-fx-pref-width: 210px;" promptText="Select sort mode" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="selectedCountLabel" text="0 selected" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" visible="false" />
                        <Button text="Previous" styleClass="btn btn-secondary" onAction="#handlePreviousPage" accessibleText="Show previous page" />
                        <Button text="Next" styleClass="btn btn-secondary" onAction="#handleNextPage" accessibleText="Show next page" />
                    </HBox>
                    <TableView fx:id="applicantsTable" styleClass="table-view" style="-fx-pref-height: 450px;" accessibleText="List of applicants for selected job">
                        <columns>
                            <TableColumn fx:id="nameColumn" text="Applicant" prefWidth="150" />
                            <TableColumn fx:id="departmentColumn" text="Department" prefWidth="120" />
                            <TableColumn fx:id="submittedAtColumn" text="Submitted At" prefWidth="150" />
                            <TableColumn fx:id="statusColumn" text="Status" prefWidth="110" />
                            <TableColumn fx:id="matchScoreColumn" text="Match Score" prefWidth="100" />
                            <TableColumn fx:id="resumeStatusColumn" text="Resume" prefWidth="110" />
                        </columns>
                    </TableView>
                </VBox>

                <VBox styleClass="card" style="-fx-pref-width: 390px;">
                    <VBox style="-fx-spacing: 4; -fx-padding: 0 0 16 0;">
                        <Label fx:id="selectedJobLabel" text="No job selected" style="-fx-font-size: 18px; -fx-font-weight: 600; -fx-text-fill: #374151;" wrapText="true" />
                    </VBox>
                    <Separator />

                    <VBox style="-fx-spacing: 12;">
                        <Label text="Applicant" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af; -fx-font-weight: 500;" />
                        <Label fx:id="applicantNameLabel" text="No applicant selected" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #1f2937;" />
                        
                        <Label text="Status" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af; -fx-font-weight: 500;" />
                        <Label fx:id="applicantStatusLabel" text="-" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" />
                        
                        <Label text="Resume" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af; -fx-font-weight: 500;" />
                        <Label fx:id="applicantResumeLabel" text="-" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" />
                        
                        <Label text="Experience" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af; -fx-font-weight: 500;" />
                        <TextArea fx:id="experienceArea" editable="false" wrapText="true" style="-fx-pref-height: 95px; -fx-border-color: #e5e7eb; -fx-border-width: 2px; -fx-border-radius: 12px; -fx-padding: 12px;" accessibleText="Applicant experience" />
                        
                        <Label text="Cover Letter" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af; -fx-font-weight: 500;" />
                        <TextArea fx:id="coverLetterArea" editable="false" wrapText="true" style="-fx-pref-height: 110px; -fx-border-color: #e5e7eb; -fx-border-width: 2px; -fx-border-radius: 12px; -fx-padding: 12px;" accessibleText="Applicant cover letter" />
                        
                        <Label text="Feedback / Review Comment" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af; -fx-font-weight: 500;" />
                        <TextArea fx:id="feedbackArea" wrapText="true" promptText="Add a shortlist note or rejection reason" style="-fx-pref-height: 110px; -fx-border-color: #e5e7eb; -fx-border-width: 2px; -fx-border-radius: 12px; -fx-padding: 12px;" accessibleText="Enter review feedback or rejection reason" />

                        <HBox style="-fx-spacing: 10; -fx-alignment: center-left;">
                            <Button fx:id="screenButton" text="Mark Screened" styleClass="btn btn-secondary" onAction="#handleScreenApplicant" accessibleText="Mark applicant as screened" />
                            <Button fx:id="acceptButton" text="Accept" styleClass="btn btn-primary" onAction="#handleAcceptApplicant" accessibleText="Accept this applicant" />
                            <Button fx:id="rejectButton" text="Reject" styleClass="btn btn-danger" onAction="#handleRejectApplicant" accessibleText="Reject this applicant" />
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
</AnchorPane>