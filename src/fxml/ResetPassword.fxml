<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ResetPasswordController">
    <VBox alignment="CENTER" spacing="0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <HBox prefHeight="8">
            <Region style="-fx-pref-width: 25%; -fx-background-color: #003366;" />
            <Region style="-fx-pref-width: 25%; -fx-background-color: #7a67ee;" />
            <Region style="-fx-pref-width: 25%; -fx-background-color: #ff9f43;" />
            <Region style="-fx-pref-width: 25%; -fx-background-color: #10b981;" />
        </HBox>

        <VBox alignment="CENTER" spacing="32" style="-fx-padding: 48px; -fx-background-color: #f9fafb; -fx-fill-width: true;">
            <VBox alignment="CENTER" spacing="24" maxWidth="520" style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,51,102,0.12), 10, 0, 0, 2); -fx-padding: 40px;">
                <VBox alignment="CENTER" spacing="8">
                    <Label text="Reset Password" style="-fx-font-size: 24px; -fx-font-weight: 700; -fx-text-fill: #1f2937;" />
                    <Label text="Verified email:" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" />
                    <Label fx:id="emailLabel" style="-fx-font-size: 15px; -fx-font-weight: 500; -fx-text-fill: #1f2937;" />
                </VBox>

                <VBox spacing="12" style="-fx-pref-width: 100%;">
                    <Label text="New Password" style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #374151;" />
                    <PasswordField fx:id="newPasswordField" promptText="At least 8 chars with letters and numbers"
                                   style="-fx-pref-width: 100%; -fx-min-height: 44px; -fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 8px; -fx-font-size: 14px;" />
                    <Label text="Confirm Password" style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #374151;" />
                    <PasswordField fx:id="confirmPasswordField" promptText="Re-enter new password"
                                   style="-fx-pref-width: 100%; -fx-min-height: 44px; -fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 8px; -fx-font-size: 14px;" />
                    <Label fx:id="errorMessage" style="-fx-font-size: 14px; -fx-text-fill: #ef4444;" />
                </VBox>

                <HBox alignment="CENTER" spacing="16">
                    <Button text="Back to Login" onAction="#handleBack"
                            style="-fx-pref-width: 140px; -fx-min-height: 42px; -fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 8px; -fx-text-fill: #374151;" />
                    <Button text="Reset Password" onAction="#handleReset"
                            style="-fx-pref-width: 140px; -fx-min-height: 42px; -fx-background-color: #003366; -fx-background-radius: 8px; -fx-text-fill: #ffffff;" />
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</AnchorPane>
