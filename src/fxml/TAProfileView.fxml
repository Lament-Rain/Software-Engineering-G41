<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="profileViewPane" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TAProfileViewController">
    <!-- Navigation Bar -->
    <VBox styleClass="navbar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 24; -fx-spacing: 16; -fx-alignment: center; -fx-fill-width: true;">
            <Label text="BUPT TA System" styleClass="navbar-title" />
            <HBox style="-fx-spacing: 8; -fx-alignment: center; -fx-padding: 0 0 0 8;">
                <StackPane style="-fx-background-radius: 50%; -fx-background-color: #003366; -fx-pref-width: 36px; -fx-pref-height: 36px; -fx-alignment: center;">
                    <Label text="TA" style="-fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 14px;" />
                </StackPane>
                <Label text="Welcome, TA Applicant" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox style="-fx-spacing: 4; -fx-alignment: center;">
                <Button text="Home" styleClass="navbar-menu" onAction="#handleHome" />
                <Button text="Job Board" styleClass="navbar-menu" onAction="#handleJobRequirements" />
                <Button text="Applications" styleClass="navbar-menu" onAction="#handleApplicationManagement" />
                <Button text="Profile" styleClass="navbar-menu active" onAction="#handlePersonalCenter" />
                <Button text="Logout" styleClass="navbar-menu" onAction="#handleLogout" />
            </HBox>
        </HBox>
    </VBox>
    
    <!-- Main Content Area -->
    <ScrollPane style="-fx-background-color: #f8f9fa;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="64.0">
        <VBox style="-fx-padding: 32px; -fx-spacing: 32px; -fx-fill-width: true; -fx-background-color: #f8f9fa; -fx-alignment: center; -fx-pref-width: 1200px;">
            <!-- Page Title -->
            <VBox alignment="CENTER" spacing="16">
                <Label text="Personal Profile" styleClass="page-title" />
                <Label text="View your personal information" styleClass="page-subtitle" />
            </VBox>
            
            <VBox styleClass="container shadow-lg" maxWidth="800" style="-fx-pref-width: 90%; -fx-background-color: #ffffff; -fx-background-radius: 12px;" spacing="32.0">
                <VBox style="-fx-padding: 32px; -fx-spacing: 24;">
                    <!-- Personal Basic Information -->
                    <VBox style="-fx-spacing: 16; -fx-padding: 0 0 24 0; -fx-border-width: 0 0 1 0; -fx-border-color: #e9ecef;">
                        <Label text="Personal Basic Information" style="-fx-font-size: 18px; -fx-font-weight: 600; -fx-text-fill: #495057;" />
                        <GridPane hgap="16" vgap="12" style="-fx-pref-width: 100%;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="150" />
                                <ColumnConstraints minWidth="200" prefWidth="300" />
                                <ColumnConstraints minWidth="120" prefWidth="150" />
                                <ColumnConstraints minWidth="200" prefWidth="300" />
                            </columnConstraints>
                            
                            <Label text="Name: " style="-fx-font-size: 14px; -fx-text-fill: #495057;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                            <Label fx:id="nameLabel" style="-fx-font-size: 14px; -fx-text-fill: #212529;" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                            
                            <Label text="Gender: " style="-fx-font-size: 14px; -fx-text-fill: #495057;" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                            <Label fx:id="genderLabel" style="-fx-font-size: 14px; -fx-text-fill: #212529;" GridPane.rowIndex="0" GridPane.columnIndex="3" />
                            
                            <Label text="Year of Birth: " style="-fx-font-size: 14px; -fx-text-fill: #495057;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                            <Label fx:id="ageLabel" style="-fx-font-size: 14px; -fx-text-fill: #212529;" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                            
                            <Label text="Department: " style="-fx-font-size: 14px; -fx-text-fill: #495057;" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                            <Label fx:id="departmentLabel" style="-fx-font-size: 14px; -fx-text-fill: #212529;" GridPane.rowIndex="1" GridPane.columnIndex="3" />
                            
                            <Label text="Grade: " style="-fx-font-size: 14px; -fx-text-fill: #495057;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                            <Label fx:id="gradeLabel" style="-fx-font-size: 14px; -fx-text-fill: #212529;" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                            
                            <Label text="Student ID: " style="-fx-font-size: 14px; -fx-text-fill: #495057;" GridPane.rowIndex="2" GridPane.columnIndex="2" />
                            <Label fx:id="studentIdLabel" style="-fx-font-size: 14px; -fx-text-fill: #212529;" GridPane.rowIndex="2" GridPane.columnIndex="3" />
                            
                            <Label text="Email: " style="-fx-font-size: 14px; -fx-text-fill: #495057;" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                            <Label fx:id="emailLabel" style="-fx-font-size: 14px; -fx-text-fill: #212529;" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                            
                            <Label text="Phone: " style="-fx-font-size: 14px; -fx-text-fill: #495057;" GridPane.rowIndex="3" GridPane.columnIndex="2" />
                            <Label fx:id="phoneLabel" style="-fx-font-size: 14px; -fx-text-fill: #212529;" GridPane.rowIndex="3" GridPane.columnIndex="3" />
                        </GridPane>
                    </VBox>
                    
                    <!-- Work Availability -->
                    <VBox style="-fx-spacing: 16; -fx-padding: 0 0 24 0; -fx-border-width: 0 0 1 0; -fx-border-color: #e9ecef;">
                        <Label text="Work Availability" style="-fx-font-size: 18px; -fx-font-weight: 600; -fx-text-fill: #495057;" />
                        <GridPane hgap="16" vgap="12" style="-fx-pref-width: 100%;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="150" />
                                <ColumnConstraints minWidth="400" prefWidth="600" />
                            </columnConstraints>
                            
                            <Label text="Specialized Subjects/Skills: " style="-fx-font-size: 14px; -fx-text-fill: #495057;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                            <Label fx:id="skillsLabel" style="-fx-font-size: 14px; -fx-text-fill: #212529; -fx-wrap-text: true;" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                            <Label text="Current Workload: " style="-fx-font-size: 14px; -fx-text-fill: #495057;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                            <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                <AnchorPane fx:id="workloadGaugePane" prefHeight="48" minHeight="48" maxHeight="48" maxWidth="320" style="-fx-background-color: transparent;" />
                            </VBox>
                        </GridPane>
                    </VBox>
                    
                    <!-- Professional Skills and Experience -->
                    <VBox style="-fx-spacing: 16;">
                        <Label text="Professional Skills and Experience" style="-fx-font-size: 18px; -fx-font-weight: 600; -fx-text-fill: #495057;" />
                        <GridPane hgap="16" vgap="12" style="-fx-pref-width: 100%;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="150" />
                                <ColumnConstraints minWidth="400" prefWidth="600" />
                            </columnConstraints>
                            
                            <Label text="Previous TA Experience: " style="-fx-font-size: 14px; -fx-text-fill: #495057;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                            <Label fx:id="experienceLabel" style="-fx-font-size: 14px; -fx-text-fill: #212529; -fx-wrap-text: true;" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                            
                            <Label text="Awards: " style="-fx-font-size: 14px; -fx-text-fill: #495057;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                            <Label fx:id="awardsLabel" style="-fx-font-size: 14px; -fx-text-fill: #212529; -fx-wrap-text: true;" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                            
                            <Label text="Other Special Skills: " style="-fx-font-size: 14px; -fx-text-fill: #495057;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                            <Label fx:id="otherSkillsLabel" style="-fx-font-size: 14px; -fx-text-fill: #212529; -fx-wrap-text: true;" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                        </GridPane>
                    </VBox>
                    
                    <!-- Action Buttons -->
                    <HBox spacing="16.0" alignment="CENTER_RIGHT" style="-fx-spacing: 16; -fx-wrap-text: true; -fx-fill-width: true; -fx-padding: 24 0 0 0; -fx-border-width: 1 0 0 0; -fx-border-color: #e9ecef;">
                        <Button text="View Resume" styleClass="btn btn-secondary" onAction="#handleViewResume" />
                        <Button text="Edit" styleClass="btn btn-primary" onAction="#handleEditProfile" />
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>
</AnchorPane>

