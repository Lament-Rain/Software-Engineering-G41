<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="emailInputPane" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.EmailInputController">
    <VBox alignment="CENTER" spacing="0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <HBox prefHeight="8">
            <Region style="-fx-pref-width: 25%; -fx-background-color: #003366;" />
            <Region style="-fx-pref-width: 25%; -fx-background-color: #1a4b80;" />
            <Region style="-fx-pref-width: 25%; -fx-background-color: #304665;" />
            <Region style="-fx-pref-width: 25%; -fx-background-color: #4a6fa5;" />
        </HBox>

        <VBox alignment="CENTER" spacing="48" style="-fx-padding: 48px; -fx-fill-width: true; -fx-background-color: #f9fafb; -fx-alignment: center;">
            <VBox alignment="CENTER" maxWidth="520" style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,51,102,0.12), 10, 0, 0, 2); -fx-padding: 48px;" spacing="48">
                <VBox alignment="CENTER" spacing="16" style="-fx-fill-width: true;">
                    <Label text="User Registration" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
                    <Label text="Create your Account" style="-fx-font-size: 16px; -fx-text-fill: #4b5563;" />
                </VBox>

                <VBox spacing="24" style="-fx-pref-width: 100%;">
                    <VBox spacing="8" style="-fx-pref-width: 100%;">
                        <Label text="Email Address" style="-fx-font-size: 14px; -fx-text-fill: #374151;" />
                        <TextField fx:id="emailField" promptText="name@company.com" style="-fx-pref-width: 100%; -fx-min-height: 48px; -fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 8px; -fx-font-size: 14px;" accessibleText="Enter your email address" />
                        <Label fx:id="emailError" style="-fx-font-size: 14px; -fx-text-fill: #ef4444;" visible="false" managed="false" />
                    </VBox>

                    <VBox spacing="8" style="-fx-pref-width: 100%;">
                        <Label text="Enter text from Image" style="-fx-font-size: 14px; -fx-text-fill: #374151;" />
                        <HBox spacing="12" alignment="CENTER" style="-fx-justify-content: center;">
                            <Label fx:id="captchaLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-background-color: #f3f4f6; -fx-border-color: #d1d5db; -fx-border-radius: 8px; -fx-pref-width: 160px; -fx-min-height: 50px; -fx-alignment: center;" />
                            <Button fx:id="refreshCaptchaButton" style="-fx-pref-width: 50px; -fx-min-height: 50px; -fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 8px;" accessibleText="Refresh captcha">
                                <graphic>
                                    <Label text="↻" style="-fx-font-size: 16px; -fx-text-fill: #6b7280;" />
                                </graphic>
                            </Button>
                        </HBox>
                        <TextField fx:id="captchaField" promptText="Enter captcha" style="-fx-pref-width: 100%; -fx-min-height: 48px; -fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 8px; -fx-font-size: 14px;" accessibleText="Enter the captcha code" />
                        <Label fx:id="captchaError" style="-fx-font-size: 14px; -fx-text-fill: #ef4444;" visible="false" managed="false" />
                    </VBox>

                    <Label fx:id="errorMessage" style="-fx-font-size: 14px; -fx-text-fill: #ef4444;" visible="false" managed="false" />
                </VBox>

                <HBox spacing="16" alignment="CENTER" style="-fx-pref-width: 100%; -fx-justify-content: center;">
                    <Button fx:id="backButton" text="Back" styleClass="btn btn-secondary" onAction="#handleBack" accessibleText="Go back to previous page" />
                    <Button fx:id="nextButton" text="Next" styleClass="btn btn-primary" onAction="#handleNext" accessibleText="Continue to email verification" />
                </HBox>
            </VBox>

            <VBox alignment="CENTER">
                <Label text="© 2026 BUPT International School. All rights reserved." textFill="#6b7280" style="-fx-font-size: 12px;" />
            </VBox>
        </VBox>
    </VBox>
</AnchorPane>
