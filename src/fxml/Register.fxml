<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane fx:id="registerScrollPane" onScroll="#handleScrollFast" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RegisterController">
    <stylesheets>
        <URL value="@../css/register.css" />
    </stylesheets>
    <StackPane style="-fx-background-color: #f9fafb;">
        <VBox alignment="TOP_CENTER" spacing="0" style="-fx-background-color: #f9fafb;">
            <fx:define>
                <ToggleGroup fx:id="roleToggleGroup" />
            </fx:define>
            <HBox prefHeight="8">
                <Region style="-fx-pref-width: 25%; -fx-background-color: #003366;" />
                <Region style="-fx-pref-width: 25%; -fx-background-color: #1a4b80;" />
                <Region style="-fx-pref-width: 25%; -fx-background-color: #304665;" />
                <Region style="-fx-pref-width: 25%; -fx-background-color: #4a6fa5;" />
            </HBox>

            <VBox alignment="CENTER" spacing="48" style="-fx-padding: 48px; -fx-background-color: #f9fafb;">
                <VBox alignment="CENTER" maxWidth="680" minWidth="400" style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,51,102,0.12), 8, 0, 0, 2); -fx-padding: 32px;" spacing="32">
                    <VBox alignment="CENTER" spacing="8">
                        <Label text="BUPT International School TA Recruitment System" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
                        <Label text="Create a new account" style="-fx-font-size: 16px; -fx-text-fill: #4b5563;" />
                    </VBox>

                    <VBox spacing="16" style="-fx-pref-width: 100%;">
                        <Label text="Select Role" style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #374151;" />
                        <HBox spacing="16" alignment="CENTER" style="-fx-pref-width: 100%;">
                            <ToggleButton fx:id="taToggle" text="TA Applicant" toggleGroup="$roleToggleGroup" selected="true" style="-fx-pref-width: 160px; -fx-min-height: 44px; -fx-font-size: 14px; -fx-font-weight: 500;" accessibleText="Register as Teaching Assistant applicant" />
                            <ToggleButton fx:id="moToggle" text="Module Organizer" toggleGroup="$roleToggleGroup" style="-fx-pref-width: 160px; -fx-min-height: 44px; -fx-font-size: 14px; -fx-font-weight: 500;" accessibleText="Register as Module Organizer" />
                            <ToggleButton fx:id="adminToggle" text="System Admin" toggleGroup="$roleToggleGroup" style="-fx-pref-width: 160px; -fx-min-height: 44px; -fx-font-size: 14px; -fx-font-weight: 500;" accessibleText="Register as System Administrator" />
                        </HBox>
                    </VBox>

                    <GridPane hgap="24" vgap="24" style="-fx-pref-width: 100%;">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                        </columnConstraints>

                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Email" style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #374151;" />
                            <TextField fx:id="emailField" promptText="Enter your email" style="-fx-pref-width: 100%; -fx-min-height: 48px; -fx-font-size: 14px; -fx-border-color: #d1d5db; -fx-border-width: 1px; -fx-background-radius: 8px; -fx-padding: 10px 16px; -fx-prompt-text-fill: #9ca3af;" accessibleText="Enter your email address" />
                            <Label fx:id="emailError" style="-fx-font-size: 12px; -fx-text-fill: #ef4444;" visible="false" managed="false" />
                        </VBox>

                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Password" style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #374151;" />
                            <PasswordField fx:id="passwordField" promptText="Enter password (at least 8 characters)" style="-fx-pref-width: 100%; -fx-min-height: 48px; -fx-font-size: 14px; -fx-border-color: #d1d5db; -fx-border-width: 1px; -fx-background-radius: 8px; -fx-padding: 10px 16px; -fx-prompt-text-fill: #9ca3af;" accessibleText="Enter a password with at least 8 characters" />
                            <Label fx:id="passwordError" style="-fx-font-size: 12px; -fx-text-fill: #ef4444;" visible="false" managed="false" />
                        </VBox>

                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Confirm Password" style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #374151;" />
                            <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" style="-fx-pref-width: 100%; -fx-min-height: 48px; -fx-font-size: 14px; -fx-border-color: #d1d5db; -fx-border-width: 1px; -fx-background-radius: 8px; -fx-padding: 10px 16px; -fx-prompt-text-fill: #9ca3af;" accessibleText="Re-enter your password to confirm" />
                            <Label fx:id="confirmPasswordError" style="-fx-font-size: 12px; -fx-text-fill: #ef4444;" visible="false" managed="false" />
                        </VBox>

                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Username" style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #374151;" />
                            <TextField fx:id="usernameField" promptText="Enter a username" style="-fx-pref-width: 100%; -fx-min-height: 48px; -fx-font-size: 14px; -fx-border-color: #d1d5db; -fx-border-width: 1px; -fx-background-radius: 8px; -fx-padding: 10px 16px; -fx-prompt-text-fill: #9ca3af;" accessibleText="Choose a username between 3 and 20 characters" />
                            <Label fx:id="usernameError" style="-fx-font-size: 12px; -fx-text-fill: #ef4444;" visible="false" managed="false" />
                        </VBox>

                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label text="Phone" style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #374151;" />
                            <TextField fx:id="phoneField" promptText="Enter your phone number" style="-fx-pref-width: 100%; -fx-min-height: 48px; -fx-font-size: 14px; -fx-border-color: #d1d5db; -fx-border-width: 1px; -fx-background-radius: 8px; -fx-padding: 10px 16px; -fx-prompt-text-fill: #9ca3af;" accessibleText="Enter your contact phone number" />
                            <Label fx:id="phoneError" style="-fx-font-size: 12px; -fx-text-fill: #ef4444;" visible="false" managed="false" />
                        </VBox>

                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label text="Department" style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #374151;" />
                            <TextField fx:id="departmentField" promptText="Required for Module Organizer" style="-fx-pref-width: 100%; -fx-min-height: 48px; -fx-font-size: 14px; -fx-border-color: #d1d5db; -fx-border-width: 1px; -fx-background-radius: 8px; -fx-padding: 10px 16px; -fx-prompt-text-fill: #9ca3af;" accessibleText="Enter your department (required for Module Organizers)" />
                            <Label fx:id="departmentError" style="-fx-font-size: 12px; -fx-text-fill: #ef4444;" visible="false" managed="false" />
                        </VBox>
                    </GridPane>

                    <VBox spacing="16" style="-fx-pref-width: 100%;">
                        <Label fx:id="errorMessage" style="-fx-font-size: 14px; -fx-text-fill: #ef4444; -fx-text-alignment: center;" />
                        <Label fx:id="successMessage" style="-fx-font-size: 14px; -fx-text-fill: #10b981; -fx-text-alignment: center;" />
                    </VBox>

                    <HBox spacing="16" alignment="CENTER" style="-fx-pref-width: 100%;">
                        <Button fx:id="backButton" text="Back to Login" styleClass="btn btn-secondary" onAction="#handleBack" accessibleText="Return to login page" />
                        <Button fx:id="registerButton" text="Create Account" styleClass="btn btn-primary" onAction="#handleRegister" accessibleText="Create your new account" />
                    </HBox>

                    <HBox spacing="16" alignment="CENTER" style="-fx-pref-width: 100%;">
                        <Label text="Keyboard shortcuts:" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" />
                        <Label text="Enter" style="-fx-font-size: 14px; -fx-font-family: monospace; -fx-font-weight: 500; -fx-text-fill: #374151; -fx-background-color: #f3f4f6; -fx-border-color: #d1d5db; -fx-border-width: 1px; -fx-background-radius: 6px; -fx-padding: 4px 8px;" />
                        <Label text="to register" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" />
                        <Region style="-fx-pref-width: 16px;" />
                        <Label text="Esc" style="-fx-font-size: 14px; -fx-font-family: monospace; -fx-font-weight: 500; -fx-text-fill: #374151; -fx-background-color: #f3f4f6; -fx-border-color: #d1d5db; -fx-border-width: 1px; -fx-background-radius: 6px; -fx-padding: 4px 8px;" />
                        <Label text="to go back" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" />
                    </HBox>
                </VBox>

                <VBox alignment="CENTER" style="-fx-padding: 16px 0;">
                    <Label text="&#169; 2026 BUPT International School. All rights reserved." style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
                </VBox>
            </VBox>
        </VBox>
    </StackPane>
</ScrollPane>