<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MOMyJobsController">
    <VBox styleClass="navbar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 24; -fx-spacing: 16; -fx-alignment: center; -fx-fill-width: true;">
            <Label text="BUPT TA System" styleClass="navbar-title" />
            <HBox style="-fx-spacing: 8; -fx-alignment: center; -fx-padding: 0 0 0 8;">
                <StackPane style="-fx-background-radius: 50%; -fx-background-color: #003366; -fx-pref-width: 36px; -fx-pref-height: 36px; -fx-alignment: center;">
                    <Label text="MO" style="-fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 14px;" />
                </StackPane>
                <Label text="Welcome, Module Organizer" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox style="-fx-spacing: 8; -fx-alignment: center;">
                <Button text="Home" styleClass="navbar-menu" onAction="#handleBack" />
                <Button text="Job Board" styleClass="navbar-menu" onAction="#handleOpenJobBoard" />
                <Button text="My Jobs" styleClass="navbar-menu active" />
                <Button text="Application Review" styleClass="navbar-menu" onAction="#handleReviewApplicationsNav" />
                <Button text="Personal Center" styleClass="navbar-menu" onAction="#handlePersonalCenter" />
                <Button text="Logout" styleClass="navbar-menu" style="-fx-pref-width: 150px;" onAction="#handleLogout" />
            </HBox>
        </HBox>
    </VBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: #f8f9fa;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
        <VBox style="-fx-padding: 32px; -fx-spacing: 24px; -fx-background-color: #f8f9fa; -fx-pref-width: 1260px;">
            <HBox alignment="CENTER_LEFT" style="-fx-spacing: 16;">
                <VBox style="-fx-spacing: 8;" HBox.hgrow="ALWAYS">
                    <Label fx:id="pageTitleLabel" text="My Jobs" styleClass="section-title" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #2c3e50;" />
                    <Label fx:id="subtitleLabel" text="Only jobs you created can be edited or withdrawn here" textFill="#6c757d" style="-fx-font-size: 14px;" />
                </VBox>
                <Label fx:id="resultCountLabel" text="Results: 0 jobs" styleClass="job-list-result-count" />
            </HBox>

            <HBox spacing="24" alignment="TOP_LEFT">
                <VBox styleClass="card shadow-md" style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-padding: 20px; -fx-spacing: 16; -fx-pref-width: 760px;">
                    <Label text="Jobs I Created" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #2c3e50;" />
                    <Label text="Double-click a row to focus it in the editor on the right." textFill="#7b8794" style="-fx-font-size: 12px;" />
                    <TableView fx:id="jobsTable" style="-fx-pref-height: 520px; -fx-fixed-cell-size: 36px; -fx-font-size: 12px;">
                        <placeholder>
                            <VBox alignment="CENTER" style="-fx-spacing: 10; -fx-padding: 32px;">
                                <Label text="No jobs found" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #5c6b7a;" />
                                <Label text="Any job you publish will appear here" style="-fx-font-size: 12px; -fx-text-fill: #8b97a3;" />
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>

                <VBox styleClass="card shadow-md" style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-padding: 24px; -fx-spacing: 16; -fx-pref-width: 440px;">
                    <Label fx:id="selectedJobLabel" text="No job selected" style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #2c3e50;" wrapText="true" />
                    <Label fx:id="statusHintLabel" text="Select a job from the left first." wrapText="true" textFill="#6c757d" style="-fx-font-size: 13px;" />
                    <Separator />

                    <VBox style="-fx-spacing: 6;">
                        <Label text="Job Title" styleClass="form-label" />
                        <TextField fx:id="titleField" promptText="Enter the job title" styleClass="form-field" />
                    </VBox>
                    <HBox spacing="12">
                        <VBox style="-fx-spacing: 6;" HBox.hgrow="ALWAYS">
                            <Label text="Job Type" styleClass="form-label" />
                            <ComboBox fx:id="typeComboBox" promptText="Select job type" />
                        </VBox>
                        <VBox style="-fx-spacing: 6;" HBox.hgrow="ALWAYS">
                            <Label text="Department" styleClass="form-label" />
                            <ComboBox fx:id="departmentComboBox" promptText="Select department" />
                        </VBox>
                    </HBox>
                    <VBox style="-fx-spacing: 6;">
                        <Label text="Weekly Schedule" styleClass="form-label" />
                        <GridPane hgap="8" vgap="6">
                            <columnConstraints>
                                <ColumnConstraints minWidth="64" prefWidth="64" />
                                <ColumnConstraints minWidth="110" prefWidth="120" hgrow="ALWAYS" />
                            </columnConstraints>
                            <CheckBox fx:id="monCheckBox" text="Mon" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <TextField fx:id="monHoursField" promptText="periods: 1-14, comma-separated" styleClass="form-field" disable="true" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <CheckBox fx:id="tueCheckBox" text="Tue" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <TextField fx:id="tueHoursField" promptText="periods: 1-14, comma-separated" styleClass="form-field" disable="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            <CheckBox fx:id="wedCheckBox" text="Wed" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <TextField fx:id="wedHoursField" promptText="periods: 1-14, comma-separated" styleClass="form-field" disable="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            <CheckBox fx:id="thuCheckBox" text="Thu" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <TextField fx:id="thuHoursField" promptText="periods: 1-14, comma-separated" styleClass="form-field" disable="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                            <CheckBox fx:id="friCheckBox" text="Fri" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                            <TextField fx:id="friHoursField" promptText="periods: 1-14, comma-separated" styleClass="form-field" disable="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                            <CheckBox fx:id="satCheckBox" text="Sat" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                            <TextField fx:id="satHoursField" promptText="periods: 1-14, comma-separated" styleClass="form-field" disable="true" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                            <CheckBox fx:id="sunCheckBox" text="Sun" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                            <TextField fx:id="sunHoursField" promptText="periods: 1-14, comma-separated" styleClass="form-field" disable="true" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                        </GridPane>
                    </VBox>
                    <HBox spacing="12">
                        <VBox style="-fx-spacing: 6;" HBox.hgrow="ALWAYS">
                            <Label text="Start Date" styleClass="form-label" />
                            <TextField fx:id="startDateField" promptText="MM-DD-YYYY" styleClass="form-field" />
                        </VBox>
                        <VBox style="-fx-spacing: 6;" HBox.hgrow="ALWAYS">
                            <Label text="End Date" styleClass="form-label" />
                            <TextField fx:id="deadlineField" promptText="MM-DD-YYYY" styleClass="form-field" />
                        </VBox>
                    </HBox>
                    <VBox style="-fx-spacing: 6;">
                        <Label text="Openings" styleClass="form-label" />
                        <TextField fx:id="recruitNumField" promptText="Enter number of openings" styleClass="form-field" />
                    </VBox>
                    <VBox style="-fx-spacing: 6;">
                        <Label text="Job Description" styleClass="form-label" />
                        <TextArea fx:id="descriptionArea" promptText="Describe the role" wrapText="true" style="-fx-min-height: 100px;" />
                    </VBox>
                    <VBox style="-fx-spacing: 6;">
                        <Label text="Skills" styleClass="form-label" />
                        <TextArea fx:id="skillsArea" promptText="Separate multiple skills with commas" wrapText="true" style="-fx-min-height: 90px;" />
                    </VBox>

                    <HBox spacing="12">
                        <Button fx:id="saveButton" text="Save Changes" styleClass="btn btn-primary" onAction="#handleSaveChanges" />
                        <Button fx:id="withdrawButton" text="Withdraw Job" styleClass="btn btn-danger" onAction="#handleWithdrawJob" />
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
</AnchorPane>





