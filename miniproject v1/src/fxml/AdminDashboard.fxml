<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.beans.binding.*?>
<?import javafx.beans.property.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.util.*?>

<AnchorPane fx:id="adminDashboardPane" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AdminDashboardController">
    <!-- 导航栏 -->
    <VBox style="-fx-background-color: #ffffff; -fx-effect: dropshadow(0, rgba(0, 51, 102, 0.12), 4, 0, 0, 6); -fx-border-width: 0 0 1 0; -fx-border-color: rgba(0, 51, 102, 0.1); -fx-height: 60px;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 20 0 20; -fx-spacing: 20; -fx-alignment: center; -fx-fill-width: true; -fx-height: 60px;">
            <Label text="BUPT TA System" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #003366;" />
            <HBox style="-fx-spacing: 12; -fx-alignment: center; -fx-fill-width: true; -fx-max-width: infinity;">
                <Button text="Home" style="-fx-background-color: #003366; -fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: 500; -fx-padding: 6 12 6 12; -fx-background-radius: 6px; -fx-min-width: 80px;" onAction="#handleHome" accessibleText="Go to home page" />
                <Button text="User Management" style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-font-size: 14px; -fx-font-weight: 500; -fx-padding: 6 12 6 12; -fx-background-radius: 6px; -fx-min-width: 120px;" onAction="#handleUserManagement" accessibleText="Manage system users" />
                <Button text="Job Management" style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-font-size: 14px; -fx-font-weight: 500; -fx-padding: 6 12 6 12; -fx-background-radius: 6px; -fx-min-width: 120px;" onAction="#handleJobManagement" accessibleText="Manage job postings" />
                <Button text="System Settings" style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-font-size: 14px; -fx-font-weight: 500; -fx-padding: 6 12 6 12; -fx-background-radius: 6px; -fx-min-width: 120px;" onAction="#handleSystemConfiguration" accessibleText="Configure system settings" />
                <Button text="Approval Center" style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-font-size: 14px; -fx-font-weight: 500; -fx-padding: 6 12 6 12; -fx-background-radius: 6px; -fx-min-width: 120px;" onAction="#handleApprovalCenter" accessibleText="Review pending approvals" />
                <Button text="Analytics" style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-font-size: 14px; -fx-font-weight: 500; -fx-padding: 6 12 6 12; -fx-background-radius: 6px; -fx-min-width: 100px;" onAction="#handleStatisticsAnalysis" accessibleText="View system analytics" />
            </HBox>
            <HBox style="-fx-spacing: 12; -fx-alignment: center;">
                <VBox style="-fx-background-color: #003366; -fx-background-radius: 50%; -fx-width: 32px; -fx-height: 32px; -fx-alignment: center; -fx-border-width: 2px; -fx-border-color: #ffffff; -fx-effect: dropshadow(0, rgba(0, 51, 102, 0.1), 2, 0, 0, 2);">
                    <Label text="Ad" style="-fx-text-fill: #ffffff; -fx-font-weight: 600; -fx-font-size: 12px;" />
                </VBox>
                <Label text="Welcome, Admin" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" />
                <Button text="Logout" style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-font-size: 14px; -fx-padding: 6 12 6 12; -fx-background-radius: 6px;" onAction="#handleLogout" accessibleText="Log out of the system" />
            </HBox>
        </HBox>
    </VBox>

    <!-- 主内容区 -->
    <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #f9fafb;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
        <VBox style="-fx-padding: 48px 24px 48px 24px; -fx-spacing: 48px; -fx-fill-width: true; -fx-background-color: #f9fafb; -fx-alignment: center; -fx-pref-width: 1240px;">
            <!-- 页面标题 -->
            <VBox style="-fx-spacing: 8; -fx-alignment: center-left; -fx-fill-width: true;">
                <Label text="Admin Dashboard" style="-fx-font-size: 32px; -fx-font-weight: 700; -fx-text-fill: #1f2937;" />
                <Label text="Manage users, jobs, and core system settings" style="-fx-font-size: 16px; -fx-text-fill: #4b5563;" />
            </VBox>

            <!-- 统计卡片 -->
            <HBox style="-fx-spacing: 16; -fx-fill-width: true; -fx-alignment: center; -fx-wrap-text: true;">
                <VBox style="-fx-pref-width: 200px; -fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-padding: 24px; -fx-spacing: 12; -fx-alignment: center; -fx-effect: dropshadow(0, rgba(0, 51, 102, 0.12), 4, 0, 0, 6);" accessibleText="Total number of system users">
                    <Label text="👥" style="-fx-font-size: 24px; -fx-text-fill: #003366;" />
                    <Label fx:id="totalUsersLabel" text="128" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #1f2937;" />
                    <Label text="Total Users" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" />
                </VBox>
                <VBox style="-fx-pref-width: 200px; -fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-padding: 24px; -fx-spacing: 12; -fx-alignment: center; -fx-effect: dropshadow(0, rgba(0, 51, 102, 0.12), 4, 0, 0, 6);" accessibleText="Total number of job postings">
                    <Label text="📄" style="-fx-font-size: 24px; -fx-text-fill: #003366;" />
                    <Label fx:id="totalJobsLabel" text="45" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #1f2937;" />
                    <Label text="Total Jobs" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" />
                </VBox>
                <VBox style="-fx-pref-width: 200px; -fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-padding: 24px; -fx-spacing: 12; -fx-alignment: center; -fx-effect: dropshadow(0, rgba(0, 51, 102, 0.12), 4, 0, 0, 6);" accessibleText="Total number of applications">
                    <Label text="📋" style="-fx-font-size: 24px; -fx-text-fill: #003366;" />
                    <Label fx:id="totalApplicationsLabel" text="237" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #1f2937;" />
                    <Label text="Total Applications" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" />
                </VBox>
            </HBox>

            <!-- 系统状态 -->
            <VBox style="-fx-fill-width: true; -fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-padding: 32px; -fx-effect: dropshadow(0, rgba(0, 51, 102, 0.12), 4, 0, 0, 6);">
                <VBox style="-fx-spacing: 8; -fx-padding: 0 0 24 0;">
                    <Label text="System Status" style="-fx-font-size: 20px; -fx-font-weight: 600; -fx-text-fill: #1f2937;" />
                    <Label text="Monitor the runtime status of core system components" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" />
                </VBox>
                <TableView fx:id="systemStatusTable" style="-fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-width: 1px; -fx-border-color: #e5e7eb;" accessibleText="System status monitor">
                    <columns>
                        <TableColumn text="Item" style="-fx-pref-width: 30%; -fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151; -fx-background-color: #f9fafb;">
                            <cellValueFactory>
                                <PropertyValueFactory property="item" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn text="Status" style="-fx-pref-width: 20%; -fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151; -fx-background-color: #f9fafb;">
                            <cellValueFactory>
                                <PropertyValueFactory property="status" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn text="Details" style="-fx-pref-width: 50%; -fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151; -fx-background-color: #f9fafb;">
                            <cellValueFactory>
                                <PropertyValueFactory property="details" />
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" style="-fx-spacing: 8; -fx-padding: 30px;">
                            <Label text="Loading system status..." style="-fx-font-size: 14px; -fx-text-fill: #8b97a3;" />
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

            <!-- 快速操作 -->
            <VBox style="-fx-fill-width: true; -fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-padding: 32px; -fx-effect: dropshadow(0, rgba(0, 51, 102, 0.12), 4, 0, 0, 6);">
                <Label text="Quick Actions" style="-fx-font-size: 20px; -fx-font-weight: 600; -fx-text-fill: #1f2937; -fx-padding: 0 0 16 0;" />
                <HBox style="-fx-spacing: 16; -fx-wrap-text: true; -fx-alignment: center-left; -fx-fill-width: true;">
                    <Button text="Admin Configuration" style="-fx-background-color: #003366; -fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: 500; -fx-padding: 10 20 10 20; -fx-background-radius: 8px;" onAction="#handleAdminConfiguration" accessibleText="Configure admin settings" />
                    <Button text="Scheduled Reports" style="-fx-background-color: #003366; -fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: 500; -fx-padding: 10 20 10 20; -fx-background-radius: 8px;" onAction="#handleScheduleReports" accessibleText="Schedule system reports" />
                    <Button text="Bulk Operations" style="-fx-background-color: #003366; -fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: 500; -fx-padding: 10 20 10 20; -fx-background-radius: 8px;" onAction="#handleBulkOperations" accessibleText="Perform bulk operations" />
                    <Button text="AI Workload Balancing" style="-fx-background-color: #ffffff; -fx-text-fill: #374151; -fx-font-size: 14px; -fx-font-weight: 500; -fx-padding: 10 20 10 20; -fx-background-radius: 8px; -fx-border-width: 1px; -fx-border-color: #d1d5db;" onAction="#handleAIWorkloadBalancing" accessibleText="Balance workload using AI" />
                    <Button text="Model API Config" style="-fx-background-color: #ffffff; -fx-text-fill: #374151; -fx-font-size: 14px; -fx-font-weight: 500; -fx-padding: 10 20 10 20; -fx-background-radius: 8px; -fx-border-width: 1px; -fx-border-color: #d1d5db;" onAction="#handleModelAPIConfig" accessibleText="Configure model API settings" />
                    <Button text="API Key Choose" style="-fx-background-color: #ffffff; -fx-text-fill: #374151; -fx-font-size: 14px; -fx-font-weight: 500; -fx-padding: 10 20 10 20; -fx-background-radius: 8px; -fx-border-width: 1px; -fx-border-color: #d1d5db;" onAction="#handleApiKeyChoose" accessibleText="Choose API key" />
                </HBox>
            </VBox>

            <!-- 键盘快捷键 -->
            <HBox spacing="16" alignment="CENTER" style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-padding: 24px; -fx-effect: dropshadow(0, rgba(0, 51, 102, 0.05), 1, 0, 0, 2);">
                <Label text="Keyboard shortcuts:" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" />
                <Label text="Ctrl+F" style="-fx-background-color: #f3f4f6; -fx-border-width: 1px; -fx-border-color: #d1d5db; -fx-background-radius: 6px; -fx-padding: 4 8 4 8; -fx-font-family: 'Inter', monospace; -fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #374151;" />
                <Label text="to search" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" />
                <Region style="-fx-pref-width: 16px;" />
                <Label text="Esc" style="-fx-background-color: #f3f4f6; -fx-border-width: 1px; -fx-border-color: #d1d5db; -fx-background-radius: 6px; -fx-padding: 4 8 4 8; -fx-font-family: 'Inter', monospace; -fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #374151;" />
                <Label text="to go home" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" />
            </HBox>
        </VBox>
    </ScrollPane>
</AnchorPane>