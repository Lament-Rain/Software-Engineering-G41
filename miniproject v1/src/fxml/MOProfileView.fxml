<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MOProfileViewController">
    <VBox styleClass="navbar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 24; -fx-spacing: 16; -fx-alignment: center; -fx-fill-width: true; -fx-min-height: 64px;">
            <Label text="BUPT TA System" styleClass="navbar-title" />
            <HBox style="-fx-spacing: 8; -fx-alignment: center; -fx-padding: 0 0 0 8;">
                <StackPane style="-fx-background-radius: 50%; -fx-background-color: #003366; -fx-pref-width: 36px; -fx-pref-height: 36px; -fx-alignment: center;">
                    <Label text="MO" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #ffffff;" />
                </StackPane>
                <Label text="Welcome, Module Organizer" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox style="-fx-spacing: 8; -fx-alignment: center;">
                <Button text="Home" styleClass="navbar-menu" onAction="#handleHome" />
                <Button text="Job Board" styleClass="navbar-menu" onAction="#handleJobManagement" />
                <Button text="My Jobs" styleClass="navbar-menu" onAction="#handleViewMyJobs" />
                <Button text="Application Review" styleClass="navbar-menu" onAction="#handleApplicationManagement" />
                <Button text="Personal Center" styleClass="navbar-menu active" onAction="#handlePersonalCenter" />
                <Button text="Logout" styleClass="navbar-menu" style="-fx-pref-width: 150px;" onAction="#handleLogout" />
            </HBox>
        </HBox>
    </VBox>

    <VBox spacing="24.0" style="-fx-padding: 32px; -fx-background-color: #f8f9fa;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
        <VBox spacing="6.0">
            <Label text="Personal Profile" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #2c3e50;" />
            <Label text="View and edit your personal basic information" style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" />
        </VBox>

        <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-padding: 24px;" spacing="16.0">
            <Label text="Personal Basic Information" style="-fx-font-size: 18px; -fx-font-weight: 600; -fx-text-fill: #495057;" />
            <GridPane hgap="16" vgap="12" style="-fx-pref-width: 100%;">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" prefWidth="180" />
                    <ColumnConstraints minWidth="220" prefWidth="300" />
                    <ColumnConstraints minWidth="120" prefWidth="180" />
                    <ColumnConstraints minWidth="220" prefWidth="300" />
                </columnConstraints>

                <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <Label fx:id="nameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="Department:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                <Label fx:id="departmentLabel" GridPane.rowIndex="0" GridPane.columnIndex="3" />

                <Label text="Username:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <Label fx:id="usernameLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <Label text="Role:" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                <Label fx:id="roleLabel" GridPane.rowIndex="1" GridPane.columnIndex="3" />

                <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <Label fx:id="emailLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                <Label text="Phone:" GridPane.rowIndex="2" GridPane.columnIndex="2" />
                <Label fx:id="phoneLabel" GridPane.rowIndex="2" GridPane.columnIndex="3" />
            </GridPane>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Edit" styleClass="btn btn-primary" onAction="#handleEditProfile" />
            </HBox>
        </VBox>
    </VBox>
</AnchorPane>
