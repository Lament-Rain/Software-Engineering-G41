<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AdminWorkloadOverviewController">
    <VBox styleClass="navbar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 24; -fx-spacing: 16; -fx-alignment: center; -fx-fill-width: true;">
            <Label text="BUPT TA System" styleClass="navbar-title" />
            <HBox style="-fx-spacing: 8; -fx-alignment: center; -fx-padding: 0 0 0 8;">
                <StackPane style="-fx-background-radius: 50%; -fx-background-color: #003366; -fx-pref-width: 36px; -fx-pref-height: 36px; -fx-alignment: center;">
                    <Label text="Ad" style="-fx-text-fill: #ffffff; -fx-font-weight: 600; -fx-font-size: 14px;" />
                </StackPane>
                <Label text="Workload Overview" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox style="-fx-spacing: 8; -fx-alignment: center;">
                <Button text="Home" styleClass="navbar-menu" onAction="#handleHome" />
                <Button text="User Management" styleClass="navbar-menu" onAction="#handleUserManagement" />
                <Button text="Job Management" styleClass="navbar-menu" onAction="#handleJobManagement" />
                <Button text="System Settings" styleClass="navbar-menu" onAction="#handleSystemConfiguration" />
                <Button text="Approval Center" styleClass="navbar-menu" onAction="#handleApprovalCenter" />
                <Button text="Analytics" styleClass="navbar-menu" onAction="#handleStatisticsAnalysis" />
                <Button text="Logout" styleClass="navbar-menu" style="-fx-pref-width: 150px;" onAction="#handleLogout" />
            </HBox>
        </HBox>
    </VBox>

    <VBox spacing="16" style="-fx-padding: 24px; -fx-background-color: #f8f9fa;" AnchorPane.topAnchor="70.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <VBox spacing="4">
            <Label text="AI Workload Overview" style="-fx-font-size: 24px; -fx-font-weight: 700; -fx-text-fill: #1f2937;" />
            <Label text="Red rows are overload (&gt;= HIGH threshold and &lt; MAX). Admin can push comments to TA next login." style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <CheckBox fx:id="overloadOnlyCheckBox" text="Show overload only" onAction="#handleFilterChanged" />
            <Label text="(OVERLOAD = red, HIGH ≤ workload &lt; MAX)" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
            <Button text="Refresh" onAction="#handleRefresh" />
        </HBox>

        <TableView fx:id="workloadTable" VBox.vgrow="ALWAYS" style="-fx-fixed-cell-size: 36px;">
            <columns>
                <TableColumn fx:id="taNameCol" text="TA" prefWidth="170" />
                <TableColumn fx:id="departmentCol" text="Department" prefWidth="170" />
                <TableColumn fx:id="hoursCol" text="Workload Hours" prefWidth="130" />
                <TableColumn fx:id="bandCol" text="Band" prefWidth="120" />
                <TableColumn fx:id="commentCol" text="AI Comment" prefWidth="520" />
            </columns>
        </TableView>

        <VBox spacing="8" style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-padding: 14px;">
            <Label text="Push message to selected TA (overload only)" style="-fx-font-size: 14px; -fx-font-weight: 600;" />
            <TextArea fx:id="pushMessageArea" promptText="Enter message that TA will see on next app launch..." style="-fx-pref-height: 96px;" wrapText="true" />
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button text="Use AI Comment" onAction="#handleUseAiComment" styleClass="btn btn-secondary" />
                <Button text="Push to TA" onAction="#handlePushToTa" styleClass="btn btn-primary" />
                <Label fx:id="statusLabel" text="" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
            </HBox>
        </VBox>
    </VBox>
</AnchorPane>
