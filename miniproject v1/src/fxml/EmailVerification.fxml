<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="emailVerificationPane" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.EmailVerificationController">
    <VBox alignment="CENTER" spacing="0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <HBox prefHeight="8">
            <Region style="-fx-pref-width: 25%; -fx-background-color: #003366;" />
            <Region style="-fx-pref-width: 25%; -fx-background-color: #7a67ee;" />
            <Region style="-fx-pref-width: 25%; -fx-background-color: #ff9f43;" />
            <Region style="-fx-pref-width: 25%; -fx-background-color: #10b981;" />
        </HBox>

        <VBox alignment="CENTER" spacing="48" style="-fx-padding: 48px; -fx-fill-width: true; -fx-background-color: #f9fafb; -fx-alignment: center; -fx-pref-width: 1200px;">
            <VBox alignment="CENTER" maxWidth="480" style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,51,102,0.12), 10, 0, 0, 2); -fx-padding: 32px;" spacing="32">
                <VBox alignment="CENTER" spacing="8" style="-fx-fill-width: true;">
                    <Label text="Verify your Email Address" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
                    <Label text="Enter the verification code sent to" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" />
                    <Label fx:id="emailLabel" style="-fx-font-size: 16px; -fx-font-weight: 500; -fx-text-fill: #1f2937;" />
                </VBox>

                <VBox spacing="24" style="-fx-pref-width: 100%;">
                    <HBox spacing="8" alignment="CENTER" style="-fx-pref-width: 100%; -fx-justify-content: center;">
                        <TextField fx:id="codeField1" style="-fx-pref-width: 48px; -fx-min-height: 48px; -fx-alignment: center; -fx-font-size: 18px; -fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 8px;" />
                        <TextField fx:id="codeField2" style="-fx-pref-width: 48px; -fx-min-height: 48px; -fx-alignment: center; -fx-font-size: 18px; -fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 8px;" />
                        <TextField fx:id="codeField3" style="-fx-pref-width: 48px; -fx-min-height: 48px; -fx-alignment: center; -fx-font-size: 18px; -fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 8px;" />
                        <TextField fx:id="codeField4" style="-fx-pref-width: 48px; -fx-min-height: 48px; -fx-alignment: center; -fx-font-size: 18px; -fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 8px;" />
                        <TextField fx:id="codeField5" style="-fx-pref-width: 48px; -fx-min-height: 48px; -fx-alignment: center; -fx-font-size: 18px; -fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 8px;" />
                        <TextField fx:id="codeField6" style="-fx-pref-width: 48px; -fx-min-height: 48px; -fx-alignment: center; -fx-font-size: 18px; -fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 8px;" />
                    </HBox>

                    <HBox alignment="CENTER" style="-fx-pref-width: 100%;">
                        <Label text="Didn't receive the code?" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" />
                        <Hyperlink fx:id="resendLink" text="Resend" style="-fx-font-size: 14px; -fx-text-fill: #003366; -fx-font-weight: 500;" />
                        <Label fx:id="resendTimer" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" />
                    </HBox>

                    <Label fx:id="errorMessage" style="-fx-font-size: 14px; -fx-text-fill: #ef4444; -fx-text-alignment: center;" />
                </VBox>

                <HBox spacing="16" alignment="CENTER" style="-fx-pref-width: 100%; -fx-justify-content: center;">
                    <Button fx:id="backButton" text="Back" onAction="#handleBack" style="-fx-pref-width: 160px; -fx-min-height: 44px; -fx-font-size: 14px; -fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-width: 1px; -fx-border-radius: 8px; -fx-text-fill: #374151;" accessibleText="Go back to previous page" />
                    <Button fx:id="verifyButton" text="Verify &amp; Continue" onAction="#handleVerify" style="-fx-pref-width: 160px; -fx-min-height: 44px; -fx-font-size: 14px; -fx-background-color: #003366; -fx-text-fill: #ffffff; -fx-border-radius: 8px;" accessibleText="Verify email and continue registration" />
                </HBox>
            </VBox>

            <VBox alignment="CENTER" style="-fx-padding: 16px 0;">
                <Label text="© 2026 BUPT International School. All rights reserved." style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
            </VBox>
        </VBox>
    </VBox>
</AnchorPane>
