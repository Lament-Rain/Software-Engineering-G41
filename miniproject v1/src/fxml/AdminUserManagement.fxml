<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AdminUserManagementController">
    <VBox styleClass="navbar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 24; -fx-spacing: 16; -fx-alignment: center; -fx-fill-width: true;">
            <Label text="BUPT TA System" styleClass="navbar-title" />
            <HBox style="-fx-spacing: 8; -fx-alignment: center; -fx-padding: 0 0 0 8;">
                <StackPane style="-fx-background-radius: 50%; -fx-background-color: #003366; -fx-pref-width: 36px; -fx-pref-height: 36px; -fx-alignment: center;">
                    <Label text="Ad" style="-fx-text-fill: #ffffff; -fx-font-weight: 600; -fx-font-size: 14px;" />
                </StackPane>
                <Label text="Welcome, Admin" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox style="-fx-spacing: 8; -fx-alignment: center;">
                <Button text="Home" styleClass="navbar-menu" onAction="#handleHome" />
                <Button text="User Management" styleClass="navbar-menu active" onAction="#handleUserManagement" />
                <Button text="Job Management" styleClass="navbar-menu" onAction="#handleJobManagement" />
                <Button text="System Settings" styleClass="navbar-menu" onAction="#handleSystemSettings" />
                <Button text="Approval Center" styleClass="navbar-menu" onAction="#handleApprovalCenter" />
                <Button text="Analytics" styleClass="navbar-menu" onAction="#handleAnalytics" />
                <Button text="Logout" styleClass="navbar-menu" style="-fx-pref-width: 150px;" onAction="#handleLogout" />
            </HBox>
        </HBox>
    </VBox>

    <VBox spacing="20.0" style="-fx-padding: 28px; -fx-background-color: #f8f9fa;" AnchorPane.topAnchor="70.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <VBox spacing="6.0">
            <Label text="Admin User Management" style="-fx-font-size: 24px; -fx-font-weight: 700; -fx-text-fill: #1f2937;" />
            <Label text="Double-click a user to view profile and change permission/status." style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" />
        </VBox>

        <HBox spacing="16" VBox.vgrow="ALWAYS">
            <VBox spacing="10" styleClass="card shadow-md" style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-padding: 14px; -fx-pref-width: 230px; -fx-min-width: 220px;">
                <Label text="Actions" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #1f2937;" />
                <Button text="Add User" styleClass="btn btn-primary" onAction="#handleAddUser" maxWidth="1.7976931348623157E308" />
                <Button text="Edit Selected" styleClass="btn btn-secondary" onAction="#handleEditSelected" maxWidth="1.7976931348623157E308" />
                <Button text="Enable/Disable" styleClass="btn btn-secondary" onAction="#handleToggleSelected" maxWidth="1.7976931348623157E308" />
                <Button text="Delete Selected" styleClass="btn btn-danger" onAction="#handleDeleteSelected" maxWidth="1.7976931348623157E308" />
                <Button text="Refresh Now" styleClass="btn btn-secondary" onAction="#handleRefresh" maxWidth="1.7976931348623157E308" />
                <Region VBox.vgrow="ALWAYS" />
                <Label text="All actions refresh the table immediately." style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" wrapText="true" />
            </VBox>

            <VBox styleClass="card shadow-md" style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-padding: 20px;" HBox.hgrow="ALWAYS">
                <TableView fx:id="userTable" VBox.vgrow="ALWAYS" style="-fx-pref-height: 420px; -fx-fixed-cell-size: 36px;">
                    <columns>
                        <TableColumn fx:id="usernameCol" text="Username" prefWidth="180" />
                        <TableColumn fx:id="emailCol" text="Email" prefWidth="280" />
                        <TableColumn fx:id="phoneCol" text="Phone" prefWidth="170" />
                        <TableColumn fx:id="roleCol" text="Role" prefWidth="120" />
                        <TableColumn fx:id="statusCol" text="Status" prefWidth="120" />
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>
