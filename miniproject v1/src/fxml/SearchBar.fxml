<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>

<AnchorPane xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SearchBarController" styleClass="search-bar-container">
    <VBox styleClass="search-bar-box">
        <!-- 头部区域 -->
        <HBox spacing="10" styleClass="search-bar-header">
            <Label text="Search Features" styleClass="search-bar-title"/>
            <Button fx:id="closeButton" text="×" styleClass="search-bar-close-button"/>
        </HBox>
        
        <!-- 搜索框区域（固定位置） -->
        <HBox styleClass="search-bar-input-container">
            <Label styleClass="search-bar-icon">🔍</Label>
            <TextField fx:id="searchField" promptText="输入关键词快速查找功能，如：保存、导出、设置" styleClass="search-bar-input"/>
            <Button fx:id="clearButton" text="×" styleClass="search-bar-clear-button" visible="false"/>
        </HBox>
        
        <!-- 结果区域（可滚动） -->
        <ScrollPane styleClass="search-bar-scroll-pane" fitToWidth="true" vbarPolicy="AS_NEEDED">
            <VBox styleClass="search-bar-content">
                <!-- 搜索结果 -->
                <ListView fx:id="searchResults" styleClass="search-bar-results"/>
                
                <!-- 无结果状态 -->
                <Label fx:id="noResultsLabel" text="未找到匹配功能，请尝试其他关键词" visible="false" styleClass="search-bar-no-results"/>
                
                <!-- 空状态（初始状态） -->
                <VBox fx:id="emptyStateContainer" visible="false" styleClass="search-bar-empty-state">
                    <Label text="热门功能" styleClass="search-bar-section-title"/>
                    <GridPane fx:id="hotFeaturesGrid" styleClass="search-bar-hot-features"/>
                    <Label text="最近使用" styleClass="search-bar-section-title"/>
                    <ListView fx:id="recentSearches" styleClass="search-bar-recent-searches"/>
                </VBox>
                
                <!-- 加载状态 -->
                <HBox fx:id="loadingContainer" visible="false" styleClass="search-bar-loading">
                    <Label styleClass="search-bar-loading-spinner">⟳</Label>
                    <Label text="正在搜索..." styleClass="search-bar-loading-text"/>
                </HBox>
            </VBox>
        </ScrollPane>
        
        <!-- 底部提示区域 -->
        <HBox styleClass="search-bar-footer">
            <Label text="按ESC关闭 | ↑↓选择结果" styleClass="search-bar-footer-hint"/>
        </HBox>
    </VBox>
</AnchorPane>