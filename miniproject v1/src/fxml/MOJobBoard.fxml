<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.JobListController">
    <VBox styleClass="navbar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 24; -fx-spacing: 16; -fx-alignment: center; -fx-fill-width: true;">
            <Label text="BUPT TA System" styleClass="navbar-title" />
            <HBox style="-fx-spacing: 8; -fx-alignment: center; -fx-padding: 0 0 0 8;">
                <StackPane style="-fx-background-radius: 50%; -fx-background-color: #003366; -fx-pref-width: 36px; -fx-pref-height: 36px; -fx-alignment: center;">
                    <Label text="MO" style="-fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 14px;" />
                </StackPane>
                <Label text="Welcome, Module Organizer" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox style="-fx-spacing: 8; -fx-alignment: center;">
                <Button text="Home" styleClass="navbar-menu" onAction="#handleBack" accessibleText="Go back to dashboard" />
                <Button text="Job Board" styleClass="navbar-menu active" onAction="#handleBack" accessibleText="Browse jobs" />
                <Button text="My Jobs" styleClass="navbar-menu" onAction="#handleMyJobs" accessibleText="View my jobs" />
                <Button text="Application Review" styleClass="navbar-menu" onAction="#handleReviewApplications" accessibleText="Review applications" />
                <Button text="Personal Center" styleClass="navbar-menu" onAction="#handlePersonalCenter" accessibleText="Go to personal center" />
                <Button text="Logout" styleClass="navbar-menu" style="-fx-pref-width: 150px;" onAction="#handleLogout" accessibleText="Log out" />
            </HBox>
        </HBox>
    </VBox>

    <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #f4f7fb;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
        <VBox style="-fx-padding: 32px; -fx-spacing: 24px; -fx-fill-width: true; -fx-background-color: #f4f7fb; -fx-alignment: center; -fx-pref-width: 1240px;">

            <HBox alignment="CENTER_LEFT" styleClass="job-list-hero">
                <VBox HBox.hgrow="ALWAYS" style="-fx-spacing: 8;">
                    <Label fx:id="pageTitleLabel" text="Job Board" styleClass="section-title" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #2c3e50;" />
                    <Label fx:id="subtitleLabel" text="Browse and manage published positions" textFill="#6c757d" style="-fx-font-size: 14px;" />
                </VBox>
                <VBox alignment="CENTER_RIGHT" style="-fx-spacing: 6;">
                    <Label text="Position Explorer" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #4a6fa5;" />
                    <Label text="Double-click a row to open the full detail" style="-fx-font-size: 12px; -fx-text-fill: #7b8794;" />
                </VBox>
            </HBox>

            <VBox styleClass="card shadow-md job-list-toolbar" style="-fx-fill-width: true; -fx-padding: 22px;">
                <Label text="Search &amp; Filters" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #31465c;" />
                <HBox style="-fx-spacing: 16; -fx-alignment: center-left; -fx-padding: 8 0 0 0;">
                    <VBox style="-fx-spacing: 6;">
                        <Label text="Keyword" styleClass="form-label" />
                        <TextField fx:id="searchField"
                                   promptText="Search by title or requirement..."
                                   styleClass="form-field search-field"
                                   style="-fx-pref-width: 340px; -fx-min-width: 340px;"
                                   accessibleText="Enter keywords to search jobs"
                                   focusTraversable="true" />
                    </VBox>
                    <VBox style="-fx-spacing: 6;">
                        <Label text="Department" styleClass="form-label" />
                        <ComboBox fx:id="departmentFilter"
                                  promptText="Select department"
                                  style="-fx-pref-width: 170px; -fx-min-width: 170px;"
                                  accessibleText="Filter by department" />
                    </VBox>
                    <VBox style="-fx-spacing: 6;">
                        <Label text="Type" styleClass="form-label" />
                        <ComboBox fx:id="typeFilter"
                                  promptText="Select type"
                                  style="-fx-pref-width: 170px; -fx-min-width: 170px;"
                                  accessibleText="Filter by job type" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <VBox alignment="BOTTOM_RIGHT" style="-fx-spacing: 10;">
                        <Label text="Combine filters and search as many times as you need" style="-fx-font-size: 12px; -fx-text-fill: #7b8794;" />
                        <HBox style="-fx-spacing: 10; -fx-alignment: center-right;">
                            <Button text="Search" styleClass="btn btn-primary" onAction="#handleSearch" style="-fx-pref-width: 92px;" accessibleText="Search jobs" />
                            <Button text="Reset" styleClass="btn btn-secondary" onAction="#handleReset" style="-fx-pref-width: 92px;" accessibleText="Reset filters" />
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <VBox styleClass="card shadow-md" style="-fx-fill-width: true; -fx-background-radius: 14px; -fx-padding: 24px;">
                <HBox alignment="CENTER_LEFT" style="-fx-spacing: 16; -fx-fill-width: true; -fx-padding: 0 0 16 0;">
                    <VBox style="-fx-spacing: 6;" HBox.hgrow="ALWAYS">
                        <Label text="Job List" styleClass="job-list-table-title" />
                        <Label text="Narrow results by keyword, department, and job type" textFill="#7b8794" style="-fx-font-size: 12px;" />
                    </VBox>
                    <Label fx:id="resultCountLabel" text="Results: 0 positions" styleClass="job-list-result-count" />
                    <Label text="Double-click for details" styleClass="job-list-hint-chip" />
                </HBox>
                <TableView fx:id="jobsTable"
                           styleClass="job-list-table"
                           style="-fx-pref-height: 620px; -fx-fixed-cell-size: 36;"
                           accessibleText="List of available job positions">
                    <placeholder>
                        <VBox alignment="CENTER" style="-fx-spacing: 10; -fx-padding: 32px;">
                            <Label text="No positions available" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #5c6b7a;" />
                            <Label text="Try adjusting the filters or check again later" style="-fx-font-size: 12px; -fx-text-fill: #8b97a3;" />
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

            <HBox alignment="CENTER_LEFT" style="-fx-spacing: 16; -fx-fill-width: true;">
                <Label text="Tip: review positions with the nearest deadlines first" style="-fx-font-size: 12px; -fx-text-fill: #7b8794;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="backButton" text="Back to Dashboard" styleClass="btn btn-secondary" onAction="#handleBack" style="-fx-pref-width: 150px; -fx-min-height: 40px;" accessibleText="Go back to dashboard" />
                <Button fx:id="createJobButton" text="Create Job" styleClass="btn btn-primary" onAction="#handleCreateJob" style="-fx-pref-width: 150px; -fx-min-height: 40px;" accessibleText="Create a new job posting" visible="false" />
            </HBox>

            <HBox spacing="16" alignment="CENTER">
                <Label text="Keyboard shortcuts:" style="-fx-font-size: 12px; -fx-text-fill: #9e9e9e;" />
                <Label text="Ctrl+F" styleClass="kbd" />
                <Label text="to search" style="-fx-font-size: 12px; -fx-text-fill: #9e9e9e;" />
                <Region style="-fx-pref-width: 16px;" />
                <Label text="Enter" styleClass="kbd" />
                <Label text="to confirm" style="-fx-font-size: 12px; -fx-text-fill: #9e9e9e;" />
                <Region style="-fx-pref-width: 16px;" />
                <Label text="Esc" styleClass="kbd" />
                <Label text="to reset" style="-fx-font-size: 12px; -fx-text-fill: #9e9e9e;" />
            </HBox>

        </VBox>
    </ScrollPane>
</AnchorPane>





